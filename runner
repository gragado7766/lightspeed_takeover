#!/bin/bash

# Define Colors
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_PURPLE='\033[0;35m'
C_CYAN='\033[0;36m'

printf "${C_CYAN}==================================================${C_RESET}\n"
printf "${C_CYAN}   Lightspeed Takeover & MDM Bypass Menu          ${C_RESET}\n"
printf "${C_CYAN}==================================================${C_RESET}\n"
printf "${C_GREEN}1) Stop and Exit${C_RESET}\n"
printf "${C_GREEN}2) Bypass MDM + Kill Lightspeed${C_RESET}\n"
printf "${C_GREEN}3) Bypass MDM + Kill Lightspeed + Remove iPhone Mirroring Block${C_RESET}\n"
printf "${C_PURPLE}4) Bypass MDM + Kill Lightspeed + Custom Profile Remover (Advanced User Caution)${C_RESET}\n"
printf "${C_RED}5) Erasure (Nuclear Option - removes all profiles)${C_RESET}\n"
printf "${C_CYAN}==================================================${C_RESET}\n"

read -p "$(printf "${C_YELLOW}Please enter your choice [1-5]: ${C_RESET}")" menu_choice

if [ "$menu_choice" == "1" ]; then
    printf "${C_RED}Exiting...${C_RESET}\n"
    exit 0
elif [[ "$menu_choice" =~ ^[2-5]$ ]]; then
    printf "${C_GREEN}Continuing with selected option...${C_RESET}\n"
else
    printf "${C_RED}Invalid choice. Exiting.${C_RESET}\n"
    exit 1
fi

printf "\n${C_CYAN}==================================================${C_RESET}\n"
printf "${C_CYAN} 1. Installing Lightspeed Auto-Killer (Daemon)    ${C_RESET}\n"
printf "${C_CYAN}==================================================${C_RESET}\n"

printf "${C_BLUE}Detecting Data Volume...${C_RESET}\n"
for disk in $(diskutil list | grep "APFS Volume" | grep -v "Recovery" | awk '{print $NF}'); do
    diskutil mount "$disk" >/dev/null 2>&1
done

DATA_VOL=""
for vol in /Volumes/*; do
    if [ -d "$vol/private/var/root" ] && [ -d "$vol/Library/LaunchDaemons" ]; then
        DATA_VOL="$vol"
        break
    fi
done

if [ -z "$DATA_VOL" ]; then
    printf "${C_RED}❌ Could not find the Data volume. Exiting.${C_RESET}\n"
    exit 1
fi
printf "${C_GREEN}✅ Found Data Volume at: $DATA_VOL${C_RESET}\n"

# Bulletproof Profile Finding Logic
printf "${C_BLUE}Locating MDM Profiles...${C_RESET}\n"
PROFILE_DIR="$DATA_VOL/private/var/db/ConfigurationProfiles"
if [ ! -d "$PROFILE_DIR" ]; then
    PROFILE_DIR=$(find /Volumes -type d -name "ConfigurationProfiles" 2>/dev/null | head -n 1)
fi

MDM_FILE=$(find "$PROFILE_DIR" -name "*.plist" 2>/dev/null | head -n 1)

if [ -z "$MDM_FILE" ]; then
    printf "${C_RED}❌ Could not find any MDM profile files.${C_RESET}\n"
    exit 1
fi
printf "${C_GREEN}✅ Found MDM Profile: $(basename "$MDM_FILE")${C_RESET}\n"

# 1. Create the script that will run on boot
cat << 'EOF' > "$DATA_VOL/private/var/root/kill-ls.sh"
#!/bin/bash
sleep 20
/usr/bin/pkill -9 lsfilter
/usr/bin/pkill -9 mobilefilter
/bin/launchctl bootout system /Library/LaunchDaemons/com.lightspeedsystems.lsfilter.plist
/bin/launchctl disable system/com.lightspeedsystems.lsfilter
/usr/sbin/networksetup -setautoproxystate "Wi-Fi" off
/usr/sbin/networksetup -setwebproxystate "Wi-Fi" off
/usr/sbin/networksetup -setsecurewebproxystate "Wi-Fi" off
/usr/bin/killall -HUP configd
/usr/bin/dscacheutil -flushcache
/usr/bin/killall -HUP mDNSResponder
/bin/rm -f /Library/LaunchDaemons/com.custom.killls.plist
/bin/rm -f /private/var/root/kill-ls.sh
EOF

chmod +x "$DATA_VOL/private/var/root/kill-ls.sh"

# 2. Create the LaunchDaemon
cat << 'EOF' > "$DATA_VOL/Library/LaunchDaemons/com.custom.killls.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.custom.killls</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/private/var/root/kill-ls.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
EOF

printf "${C_GREEN}✅ Auto-Killer installed successfully.${C_RESET}\n"

if [ "$menu_choice" == "3" ]; then
    printf "\n${C_CYAN}==================================================${C_RESET}\n"
    printf "${C_CYAN} Removing iPhone Mirroring Block Profile          ${C_RESET}\n"
    printf "${C_CYAN}==================================================${C_RESET}\n"
    
    chflags nouchg "$MDM_FILE" 2>/dev/null
    
    FOUND=0
    j=0
    INDICES_TO_DELETE=()
    
    printf "${C_BLUE}Scanning inside the MDM bundle...${C_RESET}\n"
    
    while /usr/libexec/PlistBuddy -c "Print :PayloadContent:$j" "$MDM_FILE" >/dev/null 2>&1; do
        p_name=$(/usr/libexec/PlistBuddy -c "Print :PayloadContent:$j:PayloadDisplayName" "$MDM_FILE" 2>/dev/null)
        p_id=$(/usr/libexec/PlistBuddy -c "Print :PayloadContent:$j:PayloadIdentifier" "$MDM_FILE" 2>/dev/null)
        
        if [[ "$p_name" == *"iPhone"* ]] || [[ "$p_name" == *"Mirroring"* ]] || [[ "$p_id" == *"14CE4B3F"* ]]; then
            FOUND=1
            INDICES_TO_DELETE+=($j)
        fi
        ((j++))
    done

    if [ $FOUND -eq 1 ]; then
        sorted=($(for i in "${INDICES_TO_DELETE[@]}"; do echo $i; done | sort -rn))
        for idx in "${sorted[@]}"; do
            /usr/libexec/PlistBuddy -c "Delete :PayloadContent:$idx" "$MDM_FILE"
        done
        chflags uchg "$MDM_FILE" 2>/dev/null
        printf "${C_GREEN}✅ iPhone Mirroring Block removed and locked against reinstallation.${C_RESET}\n"
    else
        printf "${C_RED}❌ Could not find the iPhone Mirroring Block profile inside the file.${C_RESET}\n"
    fi

elif [ "$menu_choice" == "4" ]; then
    printf "\n${C_PURPLE}==================================================${C_RESET}\n"
    printf "${C_PURPLE} Scanning Individual Payloads inside Profiles     ${C_RESET}\n"
    printf "${C_PURPLE}==================================================${C_RESET}\n"
    
    chflags nouchg "$MDM_FILE" 2>/dev/null
    
    j=0
    while /usr/libexec/PlistBuddy -c "Print :PayloadContent:$j" "$MDM_FILE" >/dev/null 2>&1; do
        p_name=$(/usr/libexec/PlistBuddy -c "Print :PayloadContent:$j:PayloadDisplayName" "$MDM_FILE" 2>/dev/null)
        if [ -z "$p_name" ]; then
            p_name=$(/usr/libexec/PlistBuddy -c "Print :PayloadContent:$j:PayloadIdentifier" "$MDM_FILE" 2>/dev/null)
        fi
        if [ -z "$p_name" ]; then
            p_name="Unknown Payload $((j+1))"
        fi
        
        printf "${C_PURPLE}$((j+1))) $p_name${C_RESET}\n"
        ((j++))
    done
    
    if [ "$j" -eq 0 ]; then
        printf "${C_RED}No payloads found in the MDM profile.${C_RESET}\n"
    else
        printf "${C_CYAN}--------------------------------------------------${C_RESET}\n"
        read -p "$(printf "${C_YELLOW}Enter numbers to delete (e.g., 1,3), or press Enter to skip: ${C_RESET}")" selection
        
        if [ -n "$selection" ]; then
            IFS=',' read -ra ADDR <<< "$selection"
            ZERO_BASED=()
            for num in "${ADDR[@]}"; do
                num=$(echo "$num" | xargs)
                if [[ "$num" =~ ^[0-9]+$ ]]; then
                    ZERO_BASED+=($((num - 1)))
                fi
            done
            
            if [ ${#ZERO_BASED[@]} -gt 0 ]; then
                sorted=($(for i in "${ZERO_BASED[@]}"; do echo $i; done | sort -rn))
                for idx in "${sorted[@]}"; do
                    if [ "$idx" -ge 0 ] && [ "$idx" -lt "$j" ]; then
                        printf "${C_BLUE}Removing payload $((idx+1))...${C_RESET}\n"
                        /usr/libexec/PlistBuddy -c "Delete :PayloadContent:$idx" "$MDM_FILE"
                    fi
                done
                chflags uchg "$MDM_FILE" 2>/dev/null
                printf "${C_GREEN}✅ Selected items removed and file locked.${C_RESET}\n"
            else
                printf "${C_RED}Invalid numbers entered. Skipping.${C_RESET}\n"
            fi
        else
            printf "${C_YELLOW}Skipping deletion.${C_RESET}\n"
        fi
    fi

elif [ "$menu_choice" == "5" ]; then
    printf "\n${C_RED}==================================================${C_RESET}\n"
    printf "${C_RED} ☢️ Erasure (Nuclear Option)                       ${C_RESET}\n"
    printf "${C_RED} Removing ALL Management Settings                 ${C_RESET}\n"
    printf "${C_RED}==================================================${C_RESET}\n"
    rm -rf "$PROFILE_DIR"
    mkdir -p "$PROFILE_DIR/Settings"
    touch "$PROFILE_DIR/Settings/.profilesAreInstalled"
    printf "${C_GREEN}✅ ALL management profiles and settings have been erased.${C_RESET}\n"
fi

printf "\n${C_CYAN}==================================================${C_RESET}\n"
printf "${C_CYAN} 2. Running MDM Bypass (assafdori)                ${C_RESET}\n"
printf "${C_CYAN}==================================================${C_RESET}\n"

curl -sL https://raw.githubusercontent.com/assafdori/bypass-mdm/main/bypass-mdm-v2.sh -o /tmp/bypass-mdm.sh
chmod +x /tmp/bypass-mdm.sh
/tmp/bypass-mdm.sh
